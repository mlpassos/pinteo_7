{
  "name": "pinte-o-7",
  "version": "0.1.0",
  "private": true,
  "description": "Ambiente educacional LOGO \u2014 Pinte o 7",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlpassos/pinteo_7.git"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.19.1 <12"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json",
    "lint": "eslint src tests scripts *.ts *.mjs --max-warnings 0",
    "format": "prettier --write src tests scripts web *.json *.ts *.mjs .github/workflows",
    "format:check": "prettier --check src tests scripts web *.json *.ts *.mjs .github/workflows",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "vite build",
    "docs": "typedoc",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run knip"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "eslint": "10.13.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "knip": "6.42.1",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1",
    "typedoc": "0.28.20",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
