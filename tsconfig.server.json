{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "allowJs": false,
    "checkJs": false,
    "rootDir": "src",
    "outDir": "dist/api",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/server/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
